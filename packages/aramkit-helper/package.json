{
  "name": "@local/aramkit-helper",
  "version": "1.0.9",
  "private": true,
  "type": "module",
  "description": "海斗助手隔离版：队友隐藏分、全分段/高分段英雄出装与按品质分组的海克斯推荐",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
